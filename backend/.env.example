# ==============================================================================
# Room Booking System - Backend Environment Configuration Example
# Copy this file to .env and adjust values as needed: cp .env.example .env
# ==============================================================================

# Database Connection (MongoDB)
MONGO_URL=mongodb://localhost:27017
DB_NAME=RoomBookingDB

# Security & JWT Token Configuration
JWT_SECRET_KEY=replace_with_a_secure_random_64_char_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP / Email Notification Service (Optional in Dev - logs to console if empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
EMAILS_FROM_EMAIL=noreply@roombooking.com
EMAILS_FROM_NAME="ISSHK Room Booking"
